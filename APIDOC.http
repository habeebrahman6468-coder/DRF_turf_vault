#API call for listing Turf

###
GET  http://127.0.0.1:8000/turf/
Accept:  application/json
Authorization: Basic turfadmin:turfadmin

#API call for adding Turf details
###
POST http://127.0.0.1:8000/turf/
Content-Type: application/json
Authorization: Basic turfadmin:turfadmin

  {
    "name": "turfix",
    "location": "palakkad",
    "phone": "9876543212",
    "fee": 1000
  }

#API call for fetching Turf

###
GET  http://127.0.0.1:8000/turf/2/
Accept:  application/json
Authorization: Basic turfadmin:turfadmin



#API call for updating turf details
###
PUT  http://127.0.0.1:8000/turf/2/
Content-Type: application/json
Authorization:  Basic turfadmin:turfadmin

 {
    "name": "Arena",
    "location": "wayanad",
    "phone": "9876543212",
    "fee": 1000
  }




#===============ADMIN==================
#API call for creating admin user

###
POST  http://127.0.0.1:8000/admin-register/
Content-Type: application/json


{
    "username": "turfadmin",
    "email": "turfadmin@gmail.com",
    "password":"turfadmin"
  }



#============Turf_Bookings=============

#API call for listing turf
###
GET  http://127.0.0.1:8000/booking-turf/
Accept:  application/json
Authorization: Basic turfadmin:turfadmin


#API call for posting customer
###
POST http://127.0.0.1:8000/booking-turf/
Content-Type: application/json
Authorization: Basic turfadmin:turfadmin

{
    "customer_name": "Ronaldo",
    "contact_no": "9876543210",
    "turf": 1,
    "reservation_date": "2026-10-10",
    "duration": "02:00:00"
}

### v2 endpoints =========
#API call for creating a new user
###
POST http://127.0.0.1:8000/v2/booking/signup/
Content-Type: application/json

{
    "username": "jerry",
    "email": "jerry@gmail.com",
    "password":"jerry"
  }


#api call for listing all turf reservation 

###
GET http://127.0.0.1:8000/v2/booking/reservation/
Accept: application/json
Authorization: Basic turfadmin:turfadmin


#api call for creating  turf reservation 

###
POST  http://127.0.0.1:8000/v2/booking/reservation/
Content-Type:  application/json
Authorization: Basic turfadmin:turfadmin

{
    "customer_name": "Shaiju",
    "contact_no": "9876543210",
    "turf": 2,
    "reservation_date": "2026-10-10",
    "reservation_time": "2:00:00",
    "duration": "02:00:00"
}

#API call for retrieving turf reservation
###
GET http://127.0.0.1:8000/v2/booking/reservation/2/
Accept: application/json
Authorization: Basic turfadmin:turfadmin


#api call for updating a turf reservation 
###
PUT http://127.0.0.1:8000/v2/booking/reservation/3/
Content-Type: application/json
Authorization: Basic turfadmin:turfadmin


{
    "customer_name": "Shaiju",
    "contact_no": "9876543210",
    "turf": 1,
    "reservation_date": "2026-10-10",
    "reservation_time": "1:00:00",
    "duration": "02:00:00"
}


#api call for deleting a reservation 

###
DELETE http://127.0.0.1:8000/v2/booking/reservation/3/
Accept: application/json
Authorization:  Basic turfadmin:turfadmin




















